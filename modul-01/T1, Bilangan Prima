from math import isqrt
from time import perf_counter


LIMIT = 5_000_000


def find_primes(limit: int) -> list[int]:
	"""Return all primes less than or equal to limit."""
	if limit < 2:
		return []

	odd_count = (limit + 1) // 2
	sieve = bytearray(b"\x01") * odd_count
	sieve[0] = 0

	for number in range(3, isqrt(limit) + 1, 2):
		index = number // 2
		if sieve[index]:
			first_composite = number * number // 2
			sieve[first_composite::number] = b"\x00" * (
				(odd_count - first_composite + number - 1) // number
			)

	return [2] + [number for number in range(3, limit + 1, 2) if sieve[number // 2]]


start = perf_counter()
primes = find_primes(LIMIT)
elapsed = perf_counter() - start

print(*primes, sep="\n")
print(f"There are {len(primes):,} prime numbers from 2 to {LIMIT:,}.")
print(f"Calculated in {elapsed:.3f} seconds.")
