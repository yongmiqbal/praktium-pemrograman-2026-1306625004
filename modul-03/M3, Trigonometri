def sin_maclaurin(x):
    sin_x = 0
    n = 0
    er = 100

    while er >= 5:
        suku = ((-1)**n * x**(2*n + 1)) / math.factorial(2*n + 1)
        sin_x = sin_x + suku

        nilai_eksak = math.sin(x)
        er = abs((nilai_eksak - sin_x) / nilai_eksak) * 100

        n = n + 1

    return sin_x, er


def cos_maclaurin(x):
    cos_x = 0
    n = 0
    er = 100

    while er >= 5:
        suku = ((-1)**n * x**(2*n)) / math.factorial(2*n)
        cos_x = cos_x + suku

        nilai_eksak = math.cos(x)
        er = abs((nilai_eksak - cos_x) / nilai_eksak) * 100

        n = n + 1

    return cos_x, er



