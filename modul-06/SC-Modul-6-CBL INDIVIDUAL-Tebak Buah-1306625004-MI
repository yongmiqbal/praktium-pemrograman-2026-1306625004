import random

data_buah = """
anggur apel aprikot asam atap arbei abiu alpukat anjeng bacang baguk
belimbing bengkuang benda binjai bisbul blueberry burahol blewah bit
cempedak ceplukan cermai ceri cokelat delima duku durian duwet enau enamenam
frambos hamoi hamlam holdi jamblang jambuair jambubatu jambubol jambumawar
jambumede jengkol jeruk jerukbali jerukkeprok jerukkingkit jeruknipis
jerukpurut kapulasan kawista kecapi kedondong kelapa kelengkeng kelubi ketela
kemang kepel kersen kesemek kokosan kiwi koldi kurma kelawi kenitu lai
langsat lemon leci lobak maja malaka mangga manggis markisa melon mengkudu
menteng matoa mentimun namnam nanas nangka naga nona pepaya persik pir pisang
pete rambai rambusa rambutan rukem sawo semangka sirsak siwalan srikaya
stroberi sutun terap terong tomat timunsuri ubi waluh wuni zaitun
""".split()

while True:
    buah = random.choice(data_buah)
    tebakan = set()
    nyawa = len(buah)

    print(f"\nNama buah terdiri dari {len(buah)} huruf.")
    while nyawa > 0:
        print("Nama buah:", " ".join(
            huruf if huruf in tebakan and huruf in buah else "-"
            for huruf in buah
        ))
        print(f"Kesempatan: {nyawa}")
        huruf = input("Tebak satu huruf: ").strip().lower()

        if len(huruf) != 1 or not huruf.isalpha():
            print("Masukkan satu huruf saja.")
        elif huruf in tebakan:
            print("Huruf itu sudah pernah ditebak.")
        else:
            tebakan.add(huruf)
            if huruf in buah:
                print("Benar!")
                if all(h in tebakan for h in buah):
                    print("SELAMAT, Anda menang!")
                    break
            else:
                nyawa -= 1
                print("Salah!")

    if nyawa == 0:
        print(f"Anda kalah! Nama buahnya: {' '.join(buah)}")

    ulangi= input("Mau main lagi (y/t)?: ")
    if ulangi.strip().lower() != "y":
        break

print("Terima kasih sudah bermain!")
print("##Selesai##")